PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP MO.EVENT.RECEIPT SOURCE memory.transport_receipt
OP MO.STATE.BEFORE SOURCE memory.phase_state
OP MO.KICK TRANSFORM MO.STATE.BEFORE MO.EVENT.RECEIPT apply_memory_receipt_kick
OP MO.ATTRACTOR.FIELD TRANSFORM MO.KICK orchorbital_attractor_field
OP MO.ACTIVE SELECT MO.ATTRACTOR.FIELD active_bound_attractor
OP MO.ACTIVE.SNAPSHOT TRANSFORM MO.ACTIVE persist_active_attractor_snapshot
OP MO.SMOOTH TRANSFORM MO.KICK MO.ACTIVE.SNAPSHOT MO.EVENT.RECEIPT centered_kepler_segment
OP MO.CELL.ORDER ORDER MO.EVENT.RECEIPT MO.ACTIVE.SNAPSHOT MO.SMOOTH
OP MO.CELL RETURN MO.CELL.ORDER

ASSERT MO.EVENT.RECEIPT
ASSERT MO.ACTIVE.SNAPSHOT
ASSERT MO.SMOOTH
EMIT MO.CELL

# DERIVED_INVARIANT velocity_only_kick_preserves_active_attractor_until_leak
# NEGATIVE_CONTROL tampered_active_snapshot_breaks_inverse_lineage
# STATUS RESEARCH_CANDIDATE_WITH_TARGETED_REFERENCE_TESTS
