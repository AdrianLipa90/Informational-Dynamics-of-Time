PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP NW.SIGNATURE SOURCE temporal.structural_event_signature
OP NW.ACTIVITY SOURCE temporal.event_activity
OP NW.CURRENT SOURCE temporal.event_current
OP NW.MOBILITY.ORDER ORDER NW.ACTIVITY NW.CURRENT
OP NW.MOBILITY TRANSFORM NW.MOBILITY.ORDER hyperbolic_mobility_invariant
OP NW.WAVE SOURCE temporal.wave_state
OP NW.LINK SOURCE temporal.phase_link
OP NW.COVARIANT_DIFFERENCE.ORDER ORDER NW.WAVE NW.LINK
OP NW.COVARIANT_DIFFERENCE TRANSFORM NW.COVARIANT_DIFFERENCE.ORDER gauge_covariant_edge_difference
OP NW.ACTIVATION.ORDER ORDER NW.MOBILITY NW.COVARIANT_DIFFERENCE
OP NW.ACTIVATION TRANSFORM NW.ACTIVATION.ORDER positive_wave_edge_activation
OP NW.REALIZATION.ORDER ORDER NW.SIGNATURE NW.ACTIVATION
OP NW.REALIZATION TRANSFORM NW.REALIZATION.ORDER positive_product_measure
OP NW.SUPPORT TRANSFORM NW.REALIZATION atomic_support
OP NW.RESULT.RETURN RETURN NW.SUPPORT

ASSERT NW.SIGNATURE
ASSERT NW.ACTIVITY
ASSERT NW.CURRENT
ASSERT NW.WAVE
ASSERT NW.LINK
ASSERT NW.ACTIVATION
ASSERT NW.REALIZATION
EMIT NW.RESULT.RETURN

# CANDIDATE CLAIMS: activity-current invariant -> mobility; wave activation; positive support intersection
# STATUS RESEARCH_CANDIDATE_WITH_TARGETED_REFERENCE_TESTS
