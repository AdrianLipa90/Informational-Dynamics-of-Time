PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP RK.RHO.A SOURCE relational.rho_a
OP RK.RHO.B SOURCE relational.rho_b
OP RK.ETA.A SOURCE relational.eta_a
OP RK.ETA.B SOURCE relational.eta_b
OP RK.DRIVE SOURCE relational.edge_drive
OP RK.MOBILITY.INPUT ORDER RK.RHO.A RK.RHO.B RK.ETA.A RK.ETA.B
OP RK.MOBILITY TRANSFORM RK.MOBILITY.INPUT symmetric_pair_mobility
OP RK.RATES.INPUT ORDER RK.MOBILITY RK.DRIVE
OP RK.RATES TRANSFORM RK.RATES.INPUT directed_pair_rates
OP RK.RESULT.RETURN RETURN RK.RATES

ASSERT RK.RHO.A
ASSERT RK.RHO.B
ASSERT RK.ETA.A
ASSERT RK.ETA.B
ASSERT RK.DRIVE
EMIT RK.RESULT.RETURN

# CLAIMS T009 T009A
# STATUS RESEARCH_CANDIDATE_WITH_PROVED_STRUCTURAL_IDENTITIES
