PNV_OPERATOR retrodiction_checkpoint_selection_v01
VERSION 0.1
STATUS PROVISIONAL_DOWNSTREAM_REFERENCE_CONTRACT

INPUT initial_memory_state X0
INPUT mu_memory MU_M
INPUT elapsed_segments DELTA_TAU[N]
INPUT nominal_kicks U[N]
INPUT candidate_checkpoints C_AVAIL
INPUT optional_max_condition_number KAPPA_MAX

LATENT_DIMENSION := 2 * N
CHECKPOINT_DIMENSION := 4
LOWER_BOUND := CEIL(LATENT_DIMENSION / CHECKPOINT_DIMENSION)

FOR CARDINALITY K FROM LOWER_BOUND TO SIZE(C_AVAIL)
  ENUMERATE SUBSETS C OF C_AVAIL WITH SIZE(C) == K
  J_C := KICK_SENSITIVITY_MATRIX(C)
  RANK_C := NUMERICAL_RANK(J_C)
  IF RANK_C == LATENT_DIMENSION
    KAPPA_C := CONDITION_NUMBER(J_C)
    IF KAPPA_MAX IS UNSET OR KAPPA_C <= KAPPA_MAX
      ADMIT C
    END
  END
  IF ANY SUBSET ADMITTED AT K
    SELECT MINIMUM KAPPA_C THEN LEXICOGRAPHIC C
    STOP
  END
END

FAIL_CLOSED IF NO SUBSET ADMITTED

OUTPUT selected_checkpoints
OUTPUT lower_bound_cardinality
OUTPUT selected_rank
OUTPUT selected_condition_number
OUTPUT tested_subsets

EVIDENCE_CLASS PARTIAL_OBSERVATION_REFERENCE_DIAGNOSTIC
PHYSICAL_CLAIM_STATUS NOT_EVALUATED
CANON_ALLOWED false
