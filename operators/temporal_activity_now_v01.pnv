PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP TA.RATE.FORWARD SOURCE relational.rate_forward
OP TA.RATE.REVERSE SOURCE relational.rate_reverse
OP TA.RATE.ORDER ORDER TA.RATE.FORWARD TA.RATE.REVERSE
OP TA.ACTIVITY TRANSFORM TA.RATE.ORDER positive_activity_sum
OP TA.CURRENT TRANSFORM TA.RATE.ORDER directed_current_difference
OP TA.DRIVE.ORDER ORDER TA.ACTIVITY TA.CURRENT
OP TA.DRIVE TRANSFORM TA.DRIVE.ORDER recover_edge_drive_artanh
OP TA.EVENT.LOCATION SOURCE temporal.event_location
OP TA.ATOM.ORDER ORDER TA.EVENT.LOCATION TA.ACTIVITY
OP TA.ATOM TRANSFORM TA.ATOM.ORDER positive_activity_atom
OP TA.RESULT.RETURN RETURN TA.ATOM

ASSERT TA.RATE.FORWARD
ASSERT TA.RATE.REVERSE
ASSERT TA.ACTIVITY
ASSERT TA.EVENT.LOCATION
EMIT TA.RESULT.RETURN

# CLAIMS T012 T013 T020A T021A T023A
# STATUS RESEARCH_CANDIDATE_WITH_PROVED_STRUCTURAL_IDENTITIES
