PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP KM.POSITION SOURCE memory.position
OP KM.VELOCITY SOURCE memory.velocity
OP KM.MU SOURCE memory.mu_memory
OP KM.ACTIVITY SOURCE temporal.activity
OP KM.DELTA.LAMBDA SOURCE temporal.delta_lambda
OP KM.REFERENCE.ACTIVITY SOURCE temporal.reference_activity
OP KM.TAU.ORDER ORDER KM.ACTIVITY KM.DELTA.LAMBDA KM.REFERENCE.ACTIVITY
OP KM.DELTA.TAU TRANSFORM KM.TAU.ORDER internal_elapsed_increment
OP KM.NEWTON.ORDER ORDER KM.POSITION KM.MU
OP KM.ACCELERATION TRANSFORM KM.NEWTON.ORDER memory_inverse_square_acceleration
OP KM.PROPAGATION.ORDER ORDER KM.POSITION KM.VELOCITY KM.MU KM.DELTA.TAU
OP KM.PROPAGATION TRANSFORM KM.PROPAGATION.ORDER kepler_memory_velocity_verlet_step
OP KM.ELEMENTS TRANSFORM KM.PROPAGATION memory_orbital_elements
OP KM.RESULT.ORDER ORDER KM.PROPAGATION KM.ELEMENTS
OP KM.RESULT.RETURN RETURN KM.RESULT.ORDER

ASSERT KM.POSITION
ASSERT KM.VELOCITY
ASSERT KM.MU
ASSERT KM.ACTIVITY
ASSERT KM.DELTA.LAMBDA
ASSERT KM.REFERENCE.ACTIVITY
EMIT KM.RESULT.RETURN

# CLAIMS T016 T017 T018 T019
# EQUATIONS EQ-T016 EQ-T017 EQ-T018 EQ-T019
# STATUS PROVISIONAL_DOWNSTREAM_BRANCH_REFERENCE_IMPLEMENTATION
