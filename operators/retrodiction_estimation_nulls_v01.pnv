PNV_OPERATOR retrodiction_estimation_nulls_v01
VERSION 0.1
STATUS PROVISIONAL_DOWNSTREAM_REFERENCE_CONTRACT

INPUT initial_memory_state X0
INPUT mu_memory MU_M
INPUT elapsed_segments DELTA_TAU[N]
INPUT retained_checkpoints Y_OBS[C]
INPUT checkpoint_indices C
INPUT latent_kick_count N

REQUIRE N > 0
REQUIRE OBSERVABILITY_RANK(J_R) == 2 * N
REQUIRE OBSERVATION_DIMENSION >= 2 * N

LATENT z := DIRECT_EVENT_KICKS_2D[N]
OBJECTIVE residual := NORM2(Y_OBS - FORWARD_MEMORY_CHECKPOINTS(X0, MU_M, DELTA_TAU, z, C))

ITERATE DAMPED_GAUSS_NEWTON
  J := KICK_SENSITIVITY_MATRIX(z)
  REQUIRE RANK(J) == 2 * N
  DELTA_Z := SOLVE((TRANSPOSE(J) * J + DAMPING * IDENTITY), TRANSPOSE(J) * RESIDUAL_VECTOR)
  ACCEPT_ONLY STRICT_RESIDUAL_DESCENT
  FAIL_CLOSED ON RANK_LOSS OR SINGULAR_NORMAL_EQUATIONS
END

COMMIT estimate_sha256 := SHA256(z || predicted_checkpoints || residual || metadata)
REQUIRE TRUTH_SCORER VERIFIES estimate_sha256 BEFORE SEALED_TRUTH_ACCESS

NULL NULL_ZERO_KICK := z = 0
NULL NULL_CHECKPOINT_SHUFFLE := REVERSE_CHECKPOINT_BLOCK_ORDER WITH SAME_ESTIMATOR_CAPACITY
CONTROL NULL_PRODUCT_FACTOR := (q, delta_m) -> (c*q, delta_m/c), c > 0

OUTPUT z_hat
OUTPUT residual_estimator
OUTPUT residual_zero_kick
OUTPUT residual_checkpoint_shuffle
OUTPUT estimate_sha256

PHYSICAL_CLAIM_STATUS NOT_EVALUATED
CANON_ALLOWED false
