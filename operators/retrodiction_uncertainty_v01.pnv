PNV_OPERATOR retrodiction_uncertainty_v01
VERSION 0.1
STATUS PROVISIONAL_DOWNSTREAM_REFERENCE_CONTRACT

INPUT committed_estimate EST
INPUT initial_memory_state X0
INPUT mu_memory MU_M
INPUT elapsed_segments DELTA_TAU[N]
INPUT checkpoint_indices C
INPUT observation_covariance SIGMA_Y
INPUT optional_max_condition_number KAPPA_MAX

REQUIRE SIGMA_Y FINITE
REQUIRE SIGMA_Y SYMMETRIC
REQUIRE SIGMA_Y POSITIVE_DEFINITE

L := CHOLESKY(SIGMA_Y)
J_R := KICK_SENSITIVITY_MATRIX(EST.kicks)
J_W := SOLVE(L, J_R)
S := SINGULAR_VALUES(J_W)
RANK_W := NUMERICAL_RANK(S)

REQUIRE RANK_W == LATENT_DIMENSION

KAPPA_W := MAX(S) / MIN_ADMITTED(S)
F_Z := TRANSPOSE(J_W) * J_W
C_Z := INVERSE(F_Z)
STD_Z := SQRT(DIAGONAL(C_Z))

IF KAPPA_MAX IS SET AND KAPPA_W > KAPPA_MAX
  STATUS WEIGHTED_ILL_CONDITIONED
ELSE
  STATUS WEIGHTED_IDENTIFIABLE_REFERENCE
END

R := EST.residual
Q_W := TRANSPOSE(SOLVE(L, R)) * SOLVE(L, R)
DOF := OBSERVATION_DIMENSION - LATENT_DIMENSION

OUTPUT KAPPA_W
OUTPUT F_Z
OUTPUT C_Z
OUTPUT STD_Z
OUTPUT Q_W
OUTPUT DOF

EVIDENCE_CLASS NOISE_MODEL_REFERENCE_DIAGNOSTIC
PHYSICAL_CLAIM_STATUS NOT_EVALUATED
CANON_ALLOWED false
