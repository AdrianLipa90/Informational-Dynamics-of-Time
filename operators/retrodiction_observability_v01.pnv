PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP RO.STATE.INIT SOURCE memory.initial_phase_state
OP RO.MU SOURCE memory.mu_memory
OP RO.DTAU SOURCE memory.delta_tau_sequence
OP RO.KICKS.NOMINAL SOURCE retrodiction.nominal_latent_kicks
OP RO.CHECKPOINTS SOURCE retrodiction.retained_checkpoint_indices

OP RO.FORWARD.ORDER ORDER RO.STATE.INIT RO.MU RO.DTAU RO.KICKS.NOMINAL
OP RO.SENSITIVITY.ORDER ORDER RO.FORWARD.ORDER RO.CHECKPOINTS
OP RO.SENSITIVITY.J TRANSFORM RO.SENSITIVITY.ORDER kick_sensitivity_matrix
OP RO.SPECTRUM TRANSFORM RO.SENSITIVITY.J singular_value_decomposition
OP RO.RANK TRANSFORM RO.SPECTRUM relative_rank_audit
OP RO.STATUS TRANSFORM RO.RANK retrodiction_observability_status
OP RO.RESULT.ORDER ORDER RO.SENSITIVITY.J RO.SPECTRUM RO.RANK RO.STATUS
OP RO.RESULT.RETURN RETURN RO.RESULT.ORDER

ASSERT RO.STATE.INIT
ASSERT RO.MU
ASSERT RO.DTAU
ASSERT RO.KICKS.NOMINAL
ASSERT RO.CHECKPOINTS
EMIT RO.RESULT.RETURN

# REFERENCE GATE:
# latent dimension = 2N
# checkpoint phase-state dimension = 4 per retained post-event checkpoint
# full-column-rank J_R -> LOCALLY_IDENTIFIABLE_REFERENCE
# obs_dim < latent_dim -> UNDERDETERMINED_DIMENSION
# sufficient obs_dim but rank < latent_dim -> RANK_DEFICIENT
# CLAIMS T028 T029 T030
# STATUS PROVISIONAL_DOWNSTREAM_RETRODICTION_OBSERVABILITY
