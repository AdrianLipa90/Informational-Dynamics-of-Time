PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP MK.EVENT.Q SOURCE temporal.now.event_weight_q
OP MK.IMPRINT.DELTA_M SOURCE memory.projected_imprint_delta_m
OP MK.ACTION.ORDER ORDER MK.EVENT.Q MK.IMPRINT.DELTA_M
OP MK.ACTION.GRADIENT TRANSFORM MK.ACTION.ORDER memory_event_action_gradient
OP MK.STATE.V_PRE SOURCE memory.velocity_pre
OP MK.UPDATE.ORDER ORDER MK.STATE.V_PRE MK.ACTION.GRADIENT
OP MK.STATE.V_POST TRANSFORM MK.UPDATE.ORDER apply_memory_event_kick
OP MK.RESULT.ORDER ORDER MK.ACTION.GRADIENT MK.STATE.V_POST
OP MK.RESULT.RETURN RETURN MK.RESULT.ORDER

ASSERT MK.EVENT.Q
ASSERT MK.IMPRINT.DELTA_M
ASSERT MK.STATE.V_PRE
EMIT MK.RESULT.RETURN

