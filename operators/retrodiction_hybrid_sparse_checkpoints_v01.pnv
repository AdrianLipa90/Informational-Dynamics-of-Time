SYSTEM RETRODICTION_HYBRID_SPARSE_CHECKPOINTS_V01
STATUS CANDIDATE_ONLY

INPUT INITIAL_MEMORY_STATE
INPUT ATTRACTOR_SET
INPUT DELTA_TAU_SEQUENCE
INPUT NOMINAL_KICK_SEQUENCE

LET N = LENGTH(NOMINAL_KICK_SEQUENCE)
LET LATENT_DIMENSION = 2 * N
LET EXTRA_ORIENTATION_CHANNELS = MAX(0, N - 3)

BASE_MEASUREMENT:
  FINAL_MEMORY_PARTIAL = [r_x, r_y, v_x]
  FINAL_BASIN_WEIGHTS = ORCHORBITAL_WEIGHTS(FINAL_STATE)
  EARLIER_SINGLE_BASIN_WEIGHTS = ONE_SCALAR_WEIGHT_PER_EARLIER_CHECKPOINT

FOR i IN 1..EXTRA_ORIENTATION_CHANNELS:
  LET a_i = PERSISTED_ACTIVE_ATTRACTOR(i)
  LET h_i = CROSS2D(r_i - c[a_i], v_i)
  APPEND h_i TO HYBRID_MEASUREMENT

J_BASE = FINITE_DIFFERENCE_JACOBIAN(BASE_MEASUREMENT)
J_HYBRID = FINITE_DIFFERENCE_JACOBIAN(BASE_MEASUREMENT + HYBRID_MEASUREMENT)

FAIL_CLOSED IF ACTIVE_ATTRACTOR_OR_SUPPORT_REGIME_CHANGES
FAIL_CLOSED IF LEAK_MODE
FAIL_CLOSED IF NONFINITE

PASS_LOCAL_REFERENCE IF RANK(J_HYBRID) == LATENT_DIMENSION
GLOBAL_INJECTIVITY_GATE = OPEN
