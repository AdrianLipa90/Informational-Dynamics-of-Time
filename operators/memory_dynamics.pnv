PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP MEM.EVENT.PRE SOURCE temporal.event_pre_state
OP MEM.EVENT.POST SOURCE temporal.event_post_state
OP MEM.IMPRINT TRANSFORM MEM.EVENT.PRE MEM.EVENT.POST projective_event_imprint
OP MEM.PROJECTION TRANSFORM MEM.IMPRINT memory_plane_projection
OP MEM.CENTRAL.DYNAMICS TRANSFORM MEM.PROJECTION central_memory_dynamics
OP MEM.AREAL.LAW TRANSFORM MEM.CENTRAL.DYNAMICS memory_areal_rate
OP MEM.ACTION.HOLONOMY TRANSFORM MEM.AREAL.LAW memory_action_area_holonomy
OP MEM.BERRY.PULLBACK TRANSFORM MEM.ACTION.HOLONOMY berry_memory_pullback
OP MEM.RESULT.RETURN RETURN MEM.BERRY.PULLBACK

ASSERT MEM.EVENT.PRE
ASSERT MEM.EVENT.POST
ASSERT MEM.IMPRINT
ASSERT MEM.PROJECTION
EMIT MEM.RESULT.RETURN

# CLAIMS T016 T017 T018 T019 T019A T019B T019C
# DEPENDS_ON TEMPORAL_TRANSPORT_STRUCTURAL_GATE
# STATUS MEMORY_FRONTIER_CANDIDATE
