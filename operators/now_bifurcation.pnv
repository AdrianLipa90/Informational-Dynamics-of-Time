PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP BF.NOW.SUPPORT SOURCE temporal.positive_event_support
OP BF.ACTIVITY SOURCE temporal.event_activity
OP BF.CURRENT SOURCE temporal.event_current
OP BF.GENERATOR SOURCE temporal.bifurcation_generator
OP BF.RATIO.ORDER ORDER BF.ACTIVITY BF.CURRENT
OP BF.PARAMETER TRANSFORM BF.RATIO.ORDER activity_current_to_bifurcation_phase
OP BF.OPERATOR.ORDER ORDER BF.PARAMETER BF.GENERATOR
OP BF.OPERATOR TRANSFORM BF.OPERATOR.ORDER unitary_bifurcation_operator
OP BF.COMPOSE COMPOSITION BF.NOW.SUPPORT BF.OPERATOR
OP BF.RESULT.RETURN RETURN BF.COMPOSE

ASSERT BF.NOW.SUPPORT
ASSERT BF.ACTIVITY
ASSERT BF.CURRENT
ASSERT BF.GENERATOR
EMIT BF.RESULT.RETURN

# CLAIMS T022 T024 T025 T026
# STATUS RESEARCH_CANDIDATE_WITH_STRUCTURAL_REFERENCE_TESTS
