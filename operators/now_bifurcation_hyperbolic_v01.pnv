PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP NB.ACTIVITY SOURCE temporal.event_activity
OP NB.CURRENT SOURCE temporal.event_current
OP NB.PAIR.ORDER ORDER NB.ACTIVITY NB.CURRENT
OP NB.MOBILITY TRANSFORM NB.PAIR.ORDER hyperbolic_invariant_mobility
OP NB.PHASE TRANSFORM NB.PAIR.ORDER bifurcation_rapidity_phase
OP NB.REALIZATION SOURCE temporal.wave_active_realization_weight
OP NB.GENERATOR SOURCE temporal.bifurcation_generator
OP NB.GATE.ORDER ORDER NB.REALIZATION NB.PHASE NB.GENERATOR
OP NB.GATE TRANSFORM NB.GATE.ORDER wave_active_unitary_bifurcation
OP NB.WAVE_CHANNEL.RETURN RETURN NB.MOBILITY
OP NB.BIFURCATION_CHANNEL.RETURN RETURN NB.GATE

ASSERT NB.ACTIVITY
ASSERT NB.CURRENT
ASSERT NB.MOBILITY
ASSERT NB.PHASE
ASSERT NB.REALIZATION
ASSERT NB.GENERATOR
EMIT NB.WAVE_CHANNEL.RETURN
EMIT NB.BIFURCATION_CHANNEL.RETURN

# CANDIDATE: (activity,current) <-> (mobility,bifurcation phase)
# STATUS RESEARCH_CANDIDATE_WITH_TARGETED_REFERENCE_TESTS
