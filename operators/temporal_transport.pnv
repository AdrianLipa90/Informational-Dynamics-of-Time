PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP TT.SMOOTH.SEGMENTS SOURCE temporal.smooth_segments
OP TT.EVENT.OPERATORS SOURCE temporal.bifurcation_operators
OP TT.ORDER ORDER TT.SMOOTH.SEGMENTS TT.EVENT.OPERATORS
OP TT.PROPAGATOR TRANSFORM TT.ORDER interrupted_temporal_propagator
OP TT.RESULT.RETURN RETURN TT.PROPAGATOR

ASSERT TT.SMOOTH.SEGMENTS
ASSERT TT.EVENT.OPERATORS
EMIT TT.RESULT.RETURN

# CLAIMS T030
# STATUS ORDERED_REFERENCE_PROPAGATOR
