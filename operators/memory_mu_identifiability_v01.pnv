PNV 1
EPISTEMIC CHYBA
MODE RESEARCH_CANDIDATE

OP MMU.H SOURCE memory.angular_momentum
OP MMU.P SOURCE memory.semi_latus_rectum
OP MMU.MU.HP ORDER MMU.H MMU.P
OP MMU.MU.HP.VALUE TRANSFORM MMU.MU.HP mu_from_h_p

OP MMU.A SOURCE memory.semi_major_axis
OP MMU.T SOURCE memory.internal_period
OP MMU.MU.AT ORDER MMU.A MMU.T
OP MMU.MU.AT.VALUE TRANSFORM MMU.MU.AT mu_from_a_T

OP MMU.GAMMA_RATE SOURCE memory.circulation_rate
OP MMU.LAMBDA SOURCE memory.orbit_coupling
OP MMU.MU.GAMMA ORDER MMU.GAMMA_RATE MMU.LAMBDA MMU.P
OP MMU.MU.GAMMA.VALUE TRANSFORM MMU.MU.GAMMA mu_from_circulation

OP MMU.RESULT.ORDER ORDER MMU.MU.HP.VALUE MMU.MU.AT.VALUE MMU.MU.GAMMA.VALUE
OP MMU.RESULT.RETURN RETURN MMU.RESULT.ORDER

ASSERT MMU.P
EMIT MMU.RESULT.RETURN

# CLAIMS T019G T019H T019I
# STATUS MEMORY_FRONTIER_CANDIDATE_CONDITIONAL_IDENTIFIABILITY
